# Copier en .env.local (gitignoré) et adapter à votre environnement.
# localhost ne résout pas vers la machine de dev depuis un device/émulateur physique :
# utiliser l'IP LAN de la machine qui héberge l'API (ex: 192.168.1.42).
API_BASE_URL=http://<IP-LAN>:3000/api/v1
SOCKET_BASE_URL=http://<IP-LAN>:3000
