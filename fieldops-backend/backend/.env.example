# ---------- Application ----------
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:3001

# ---------- Base de données (PostgreSQL + PostGIS) ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=fieldops
# true uniquement en développement : en staging/prod utiliser les migrations
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=true
DB_LOGGING=false

# ---------- Redis (cache, positions live, BullMQ) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT ----------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=30
JWT_MFA_SECRET=change-me-mfa-secret-min-32-characters-xx

# ---------- Stockage objet S3 (AWS / OVH / Scaleway / MinIO) ----------
S3_ENDPOINT=http://localhost:9000
# Hôte des URL signées, s'il diffère de S3_ENDPOINT (API en Docker : S3_ENDPOINT=http://minio:9000).
S3_PUBLIC_ENDPOINT=
S3_REGION=eu-west-3
S3_BUCKET=fieldops-proofs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL=600

# ---------- Notifications ----------
# Push : expo | log
PUSH_PROVIDER=log
# Email : smtp | log
EMAIL_PROVIDER=log
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="FieldOps <no-reply@fieldops.local>"
# SMS : log (brancher Twilio / OVH SMS / Brevo dans SmsProvider)
SMS_PROVIDER=log

# ---------- Sécurité ----------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# ---------- Observabilité ----------
SENTRY_DSN=
LOG_LEVEL=log

# ---------- V3 : planificateurs, intégrations, observabilité ----------
# false : désactive les jobs planifiés (SLA, maintenance préventive, rétention) sur cette instance
SCHEDULERS_ENABLED=true
# Webhooks : en production, HTTPS obligatoire et réseaux privés interdits (protection SSRF).
# Laisser vide pour le comportement par défaut ; true uniquement pour un ERP hébergé sur le réseau interne.
WEBHOOKS_ALLOW_HTTP=
WEBHOOKS_ALLOW_PRIVATE=
# Prometheus : GET /api/metrics — jeton Bearer requis si défini
METRICS_TOKEN=
# Logs : json pour la centralisation (Loki, ELK, CloudWatch), vide = texte lisible
LOG_FORMAT=
# Sentry (optionnel)
SENTRY_TRACES_SAMPLE_RATE=0
APP_VERSION=3.0.0
