# ---------- Application ----------
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:3001

# ---------- Base de données (PostgreSQL + PostGIS) ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=fieldops
# true uniquement en développement : en staging/prod utiliser les migrations
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=true
DB_LOGGING=false

# ---------- Redis (cache, positions live, BullMQ) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT ----------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=30
JWT_MFA_SECRET=change-me-mfa-secret-min-32-characters-xx

# ---------- Stockage objet S3 (AWS / OVH / Scaleway / MinIO) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-3
S3_BUCKET=fieldops-proofs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL=600

# ---------- Notifications ----------
# Push : expo | log
PUSH_PROVIDER=log
# Email : smtp | log
EMAIL_PROVIDER=log
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="FieldOps <no-reply@fieldops.local>"
# SMS : log (brancher Twilio / OVH SMS / Brevo dans SmsProvider)
SMS_PROVIDER=log

# ---------- Sécurité ----------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# ---------- Observabilité ----------
SENTRY_DSN=
LOG_LEVEL=log
